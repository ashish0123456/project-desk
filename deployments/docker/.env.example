# Copy this file to /opt/project-management/.env on the Oracle VM.
# Do not commit the real file. Generate strong unique values for production.

POSTGRES_USER=pm_app
POSTGRES_PASSWORD=REPLACE_WITH_A_LONG_RANDOM_DATABASE_PASSWORD
AUTH_JWT_SECRET=REPLACE_WITH_A_LONG_RANDOM_JWT_SECRET

# Optional settings
GATEWAY_PORT=8080
LOG_LEVEL=info
VERSION=0.1.0
WORKER_COUNT=5
