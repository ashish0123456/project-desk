# Application
APP_NAME=Project Management Platform
APP_ENV=development
LOG_LEVEL=info
VERSION=0.1.0

# API Gateway
GATEWAY_PORT=8080

# Auth Service
AUTH_GRPC_PORT=50051
AUTH_DB_HOST=localhost
AUTH_DB_PORT=5432
AUTH_DB_USER=postgres
AUTH_DB_PASSWORD=postgres
AUTH_DB_NAME=pm_auth
AUTH_DB_SSLMODE=disable

# Project Service
PROJECT_GRPC_PORT=50052
PROJECT_DB_HOST=localhost
PROJECT_DB_PORT=5433
PROJECT_DB_USER=postgres
PROJECT_DB_PASSWORD=postgres
PROJECT_DB_NAME=pm_project
PROJECT_DB_SSLMODE=disable

# Issue Service
ISSUE_GRPC_PORT=50053
ISSUE_DB_HOST=localhost
ISSUE_DB_PORT=5434
ISSUE_DB_USER=postgres
ISSUE_DB_PASSWORD=postgres
ISSUE_DB_NAME=pm_issue
ISSUE_DB_SSLMODE=disable

# Worker Service
WORKER_COUNT=5
REDIS_ADDR=localhost:6379
